APP_NAME=Voice AI Interview Platform
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/voiceai
REDIS_URL=redis://localhost:6379/0

# Required for live WebRTC voice interviews (OpenAI Realtime).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

INTERVIEW_MAX_MINUTES=12
INTERVIEW_MAX_QUESTIONS=6
VOICE_CLIENT_SECRET_TTL_SECONDS=600

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
